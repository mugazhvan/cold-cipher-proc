# Application Metadata
APP_ENV=development
APP_NAME=KisanFlow
DEBUG=true

# Backend Server Configuration
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:lh44@localhost:5432/kisanflow
DATABASE_URL_SYNC=postgresql://postgres:lh44@localhost:5432/kisanflow

# JWT Authentication
JWT_SECRET_KEY=kisanflow_dev_jwt_secret_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Mock Integration Flags (Prototype Mode)
OTP_MODE=mock
MOCK_OTP_CODE=123456
PAYMENT_MODE=simulated
NOTIFICATION_MODE=mock

# Map Service Configuration (Optional)
MAP_PROVIDER=openstreetmap

# Frontend Base URLs (CORS & API connection)
VITE_API_BASE_URL=http://localhost:8000/api/v1
FARMER_APP_PORT=3000
MANAGEMENT_APP_PORT=3001
